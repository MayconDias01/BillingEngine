# Copie para .env e preencha antes de rodar docker-compose up
# NUNCA commite o .env com valores reais

# PostgreSQL
DB_PASSWORD=billing123

# RabbitMQ
RABBITMQ_USER=billing
RABBITMQ_PASS=billing123

# JWT — deixe vazio para chave efêmera em dev (tokens invalidados ao reiniciar)
CERT_PASSWORD=

# AES-256-GCM — 32 bytes em base64. Gere com: openssl rand -base64 32
AES_KEY=SUBSTITUA_PELA_SUA_CHAVE_AES_BASE64_32_BYTES
